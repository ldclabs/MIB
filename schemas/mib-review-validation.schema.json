{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MIB development fixture validation",
  "type": "object",
  "additionalProperties": false,
  "required": ["mib", "kind", "version", "empirical", "release_eligible", "results"],
  "properties": {
    "mib": {"const": "0.2"},
    "kind": {"const": "MIBReviewFixtureValidation"},
    "version": {"type": "string"},
    "empirical": {"const": false},
    "release_eligible": {"const": false},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "agent", "score", "dependence_eligible", "verified", "instances", "runs"],
        "properties": {
          "profile": {"type": "string"},
          "agent": {"type": "string"},
          "score": {"type": "number", "minimum": 0, "maximum": 100},
          "dependence_eligible": {"type": ["boolean", "null"]},
          "verified": {"const": true},
          "instances": {"type": "integer", "minimum": 1},
          "runs": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
