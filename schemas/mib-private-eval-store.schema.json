{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mib:0.1:schema:private-eval-store",
  "title": "MIB Private Evaluation Store Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "version",
    "profile",
    "templates"
  ],
  "properties": {
    "mib": {
      "const": "0.1"
    },
    "kind": {
      "const": "MIBPrivateEvaluationStore"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "visibility",
          "public_id",
          "instances"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "visibility": {
            "enum": [
              "hidden_eval",
              "private_holdout"
            ]
          },
          "public_id": {
            "type": "string"
          },
          "instances": {
            "type": "integer",
            "minimum": 1
          },
          "title_public": {
            "type": "string"
          }
        }
      }
    }
  }
}
