    "Ablation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "probes",
        "method",
        "expected_effect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "relevant_memory",
            "irrelevant_memory",
            "no_memory",
            "stale_memory",
            "harmful_memory",
            "counterexample",
            "custom"
