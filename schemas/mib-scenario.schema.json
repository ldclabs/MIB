            "properties": {
              "evaluator": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "AblationTargets": {
      "type": "object",
      "additionalProperties": false,
