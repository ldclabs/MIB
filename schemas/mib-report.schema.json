{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mib:0.1:schema:report",
  "title": "MIB Report",
  "description": "Machine-readable score report for the Memory Intelligence Benchmark. Records benchmark identity, system identity, per-run/per-probe evidence, Scenario/Template/Dimension aggregation, causal metrics, coverage, statistics, efficiency, warnings, and enough numeric material to recompute the published score.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mib",
    "kind",
    "report_version",
    "report_id",
    "generated_at",
    "benchmark",
    "system",
    "execution",
    "results",
    "aggregates",
    "coverage",
    "statistics"
  ],
  "properties": {
    "mib": {
      "type": "string",
      "enum": [
        "0.1",
        "0.2"
      ],
      "description": "MIB report format family."
    },
    "kind": {
      "type": "string",
      "const": "MIBReport"
    },
    "report_version": {
      "$ref": "#/$defs/SemVer"
    },
    "report_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "string",
      "enum": [
        "internal",
        "submission",
        "public"
      ],
      "default": "submission",
      "description": "Controls expected disclosure/redaction policy, not score semantics."
    },
    "benchmark": {
      "$ref": "#/$defs/BenchmarkIdentity"
    },
    "system": {
      "$ref": "#/$defs/SystemIdentity"
    },
    "adapter": {
      "$ref": "#/$defs/AdapterIdentity"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentIdentity"
    },
    "execution": {
      "$ref": "#/$defs/ExecutionSummary"
    },
    "results": {
      "$ref": "#/$defs/ResultEvidence"
    },
    "aggregates": {
      "$ref": "#/$defs/Aggregates"
    },
    "causal_metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CausalMetric"
      }
    },
    "coverage": {
      "$ref": "#/$defs/CoverageSummary"
    },
    "statistics": {
      "$ref": "#/$defs/StatisticsSummary"
    },
    "efficiency": {
      "$ref": "#/$defs/EfficiencySummary"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Warning"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      }
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "integrity": {
      "$ref": "#/$defs/Integrity"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"
      },
      "additionalProperties": true
    },
    "retention": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "template_id",
          "rungs"
        ],
        "properties": {
          "template_id": {
            "type": "string"
          },
          "canonical_rung": {
            "type": [
              "integer",
              "null"
            ]
          },
          "rungs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rung",
                "full_score",
                "n"
              ],
              "properties": {
                "rung": {
                  "type": "integer"
                },
                "interference_count": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "full_score": {
                  "type": "number"
                },
                "n": {
                  "type": "integer"
                },
                "interference_tokens": {
                  "type": "number",
                  "minimum": 0
                },
                "distance_hours": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "retention_index": {
            "type": "number"
          },
          "half_distance": {
            "type": [
              "number",
              "null"
            ]
          },
          "half_distance_beyond_ladder": {
            "type": "boolean"
          }
        }
      }
    },
    "memory_dependence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content_tracking_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "stale_adoption_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "memory_benefit": {
          "type": [
            "number",
            "null"
          ]
        },
        "headroom_normalized_memory_benefit": {
          "type": [
            "number",
            "null"
          ]
        },
        "harm_resistance": {
          "type": [
            "number",
            "null"
          ]
        },
        "consolidation_benefit": {
          "type": [
            "number",
            "null"
          ]
        },
        "error_recurrence_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "floor": {
          "type": "number"
        },
        "metric": {
          "type": "string"
        },
        "eligible": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "eligible_n": {
          "type": "integer"
        },
        "total_n": {
          "type": "integer"
        }
      }
    }
  },
  "$defs": {
    "SemVer": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "JsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "Score01": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Normalized internal score."
    },
    "Score100": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Displayed capability score."
    },
    "SignedUnit": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "Rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "ConfidenceInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "lower",
        "upper",
        "method"
      ],
      "properties": {
        "level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "method": {
          "type": "string",
          "enum": [
            "hierarchical_bootstrap_percentile",
            "paired_hierarchical_bootstrap_percentile",
            "bootstrap_percentile",
            "bca",
            "normal_approximation",
            "binomial",
            "custom"
          ]
        },
        "resamples": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "ScoreWithCI": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "ci": {
          "$ref": "#/$defs/ConfidenceInterval"
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "stddev": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "BenchmarkIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mib_version",
        "profile",
        "track",
        "scale",
        "scenario_pack"
      ],
      "properties": {
        "mib_version": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string"
            }
          }
        },
        "track": {
          "type": "string",
          "enum": [
            "memory_system",
            "integrated_agent",
            "diagnostics"
          ]
        },
        "scale": {
          "type": "string",
          "enum": [
            "MIB-S",
            "MIB-M",
            "MIB-L",
            "custom"
          ]
        },
        "scenario_pack": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string"
            }
          }
        },
        "scoring_spec_version": {
          "type": "string"
        },
        "scenario_schema_version": {
          "type": "string"
        },
        "agent_adapter_protocol": {
          "type": "string"
        }
      }
    },
    "ComponentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "vendor": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "configuration_digest": {
          "type": "string"
        }
      }
    },
    "ModelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "vendor": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "configuration_digest": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "endpoint_class": {
          "type": "string"
        },
        "sampling": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "SystemIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent"
      ],
      "properties": {
        "agent": {
          "$ref": "#/$defs/ComponentIdentity"
        },
        "model": {
          "$ref": "#/$defs/ModelIdentity"
        },
        "memory": {
          "$ref": "#/$defs/ComponentIdentity"
        },
        "orchestrator": {
          "$ref": "#/$defs/ComponentIdentity"
        },
        "system_prompt_digest": {
          "type": "string"
        },
        "tool_policy_digest": {
          "type": "string"
        },
        "external_services": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "AdapterIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "type": "string"
        },
        "implementation": {
          "$ref": "#/$defs/ComponentIdentity"
        },
        "descriptor_digest": {
          "type": "string"
        },
        "conformance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "suite_version": {
              "type": "string"
            },
            "report_ref": {
              "type": "string"
            }
          }
        }
      }
    },
    "EnvironmentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runner": {
          "$ref": "#/$defs/ComponentIdentity"
        },
        "world_simulator": {
          "$ref": "#/$defs/ComponentIdentity"
        },
        "tool_runtime": {
          "$ref": "#/$defs/ComponentIdentity"
        },
        "evaluator_bundle": {
          "$ref": "#/$defs/ComponentIdentity"
        },
        "judge_models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentIdentity"
          }
        },
        "platform": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "ExecutionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "completed_at",
        "scheduled_probe_attempts",
        "execution_failed_probe_attempts"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "scheduled_runs": {
          "type": "integer",
          "minimum": 0
        },
        "completed_runs": {
          "type": "integer",
          "minimum": 0
        },
        "scheduled_probe_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "execution_failed_probe_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "execution_failure_rate": {
          "$ref": "#/$defs/Rate"
        },
        "unsupported_required_weight": {
          "type": "number",
          "minimum": 0
        },
        "total_required_weight": {
          "type": "number",
          "minimum": 0
        },
        "unsupported_rate": {
          "$ref": "#/$defs/Rate"
        },
        "repetitions_policy": {
          "type": "object",
          "additionalProperties": true
        },
        "condition_order_policy": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "EvaluatorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluator_id",
        "score"
      ],
      "properties": {
        "evaluator_id": {
          "type": "string"
        },
        "evaluator_type": {
          "type": "string"
        },
        "score": {
          "$ref": "#/$defs/Score01"
        },
        "passed": {
          "type": "boolean"
        },
        "failure_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "formation_miss",
              "retrieval_miss",
              "identity_mismatch",
              "stale_memory_adoption",
              "source_confusion",
              "correction_loss",
              "false_certainty",
              "trajectory_collapse",
              "skill_non_transfer",
              "negative_transfer",
              "counterexample_neglect",
              "commitment_miss",
              "self_model_drift",
              "memory_hallucination",
              "irrelevant_memory_interference",
              "authority_confusion",
              "agent_protocol_violation",
              "error_recurrence",
              "premature_trigger",
              "execution_failure",
              "timeout",
              "rate_limited",
              "adapter_error",
              "tool_error",
              "evaluator_error",
              "custom"
            ]
          }
        },
        "details": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "rubric_version": {
              "type": "string"
            },
            "samples": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "ProbeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "outcome",
        "condition",
        "repetition",
        "weight"
      ],
      "properties": {
        "probe_id": {
          "type": "string"
        },
        "probe_kind": {
          "type": "string"
        },
        "condition": {
          "type": "string",
          "enum": [
            "full",
            "relevant_ablation",
            "irrelevant_ablation",
            "no_memory",
            "harmful_memory",
            "stale_memory",
            "counterexample",
            "full_context",
            "custom",
            "counterfactual_content",
            "no_maintenance",
            "negative_transfer_control"
          ]
        },
        "repetition": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "type": "string",
          "enum": [
            "scored",
            "execution_failure",
            "unsupported",
            "invalid",
            "not_run"
          ]
        },
        "score": {
          "$ref": "#/$defs/Score01"
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "retention_retrieval",
              "temporal_memory",
              "epistemic_memory",
              "experience_memory",
              "skill_learning_transfer",
              "selective_forgetting",
              "prospective_self_memory",
              "causal_memory_impact"
            ]
          }
        },
        "evaluator_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvaluatorResult"
          }
        },
        "failure_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "formation_miss",
              "retrieval_miss",
              "identity_mismatch",
              "stale_memory_adoption",
              "source_confusion",
              "correction_loss",
              "false_certainty",
              "trajectory_collapse",
              "skill_non_transfer",
              "negative_transfer",
              "counterexample_neglect",
              "commitment_miss",
              "self_model_drift",
              "memory_hallucination",
              "irrelevant_memory_interference",
              "authority_confusion",
              "agent_protocol_violation",
              "error_recurrence",
              "premature_trigger",
              "execution_failure",
              "timeout",
              "rate_limited",
              "adapter_error",
              "tool_error",
              "evaluator_error",
              "custom"
            ]
          }
        },
        "output_ref": {
          "type": "string"
        },
        "output_digest": {
          "type": "string"
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "usage": {
          "$ref": "#/$defs/UsageMetrics"
        },
        "counterfactual": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tracks": {
              "type": "boolean"
            },
            "stale": {
              "type": "boolean"
            }
          }
        },
        "recurrence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eligible": {
              "type": "boolean"
            },
            "recurred": {
              "type": "boolean"
            }
          }
        },
        "traps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Memory failures this Probe's Oracle could elicit (eligibility for §7.9 rates)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "scored"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "score"
            ]
          }
        }
      ]
    },
    "RunResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "scenario_instance_id",
        "template_id",
        "condition",
        "repetition",
        "status",
        "probe_results"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "scenario_instance_id": {
          "type": "string"
        },
        "scenario_instance_version": {
          "type": "string"
        },
        "template_id": {
          "type": "string"
        },
        "template_version": {
          "type": "string"
        },
        "instance_seed": {
          "type": [
            "integer",
            "string"
          ]
        },
        "condition": {
          "type": "string",
          "enum": [
            "full",
            "relevant_ablation",
            "irrelevant_ablation",
            "no_memory",
            "harmful_memory",
            "stale_memory",
            "counterexample",
            "full_context",
            "custom",
            "counterfactual_content",
            "no_maintenance",
            "negative_transfer_control"
          ]
        },
        "ablation_id": {
          "type": "string"
        },
        "ablation_method": {
          "type": "string"
        },
        "repetition": {
          "type": "integer",
          "minimum": 0
        },
        "agent_seed": {
          "type": [
            "integer",
            "string"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed",
            "unsupported",
            "invalid",
            "not_run"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "scenario_score": {
          "$ref": "#/$defs/Score01"
        },
        "penalty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "probe_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProbeResult"
          }
        },
        "usage": {
          "$ref": "#/$defs/UsageMetrics"
        },
        "validity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "causal_pair_valid": {
              "type": "boolean"
            },
            "runner_valid": {
              "type": "boolean"
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "trace_ref": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
