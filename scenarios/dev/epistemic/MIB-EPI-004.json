{
  "mib": "0.1",
  "kind": "MemoryEpisodeProgram",
  "id": "MIB-EPI-004",
  "version": "0.1.0",
  "status": "candidate",
  "title": "Tool Evidence vs Human Statement",
  "description": "The meeting owner states a start time first-hand while the Calendar Tool holds a different, merely auto-synced record. Surface authority favours the owner; a remembered workspace policy says the Calendar Tool nevertheless governs scheduling. The Agent must remember and apply the policy rather than defer to the more authoritative-sounding source.",
  "suite": "epistemic",
  "dimensions": [
    "epistemic_memory",
    "causal_memory_impact"
  ],
  "tags": [
    "tool-evidence",
    "human-statement",
    "source-preference"
  ],
  "difficulty": {
    "level": "easy",
    "meaningful_events": 3,
    "distractor_events": 1,
    "entity_count": 3,
    "memory_hops": 0,
    "probe_indirectness": 0.2
  },
  "template": {
    "is_template": true,
    "parameters": [
      {
        "name": "person_name",
        "type": "string",
        "source": "choice",
        "visibility": "public",
        "choices": [
          "Devon",
          "Priya",
          "Mateo",
          "Iris"
        ]
      },
      {
        "name": "human_time",
        "type": "string",
        "source": "choice",
        "visibility": "public",
        "choices": [
          "16:00",
          "13:30",
          "11:00"
        ]
      },
      {
        "name": "calendar_time",
        "type": "string",
        "source": "choice",
        "visibility": "public",
        "choices": [
          "15:00",
          "12:30",
          "10:00"
        ]
      },
      {
        "name": "meeting_name",
        "type": "string",
        "source": "choice",
        "visibility": "public",
        "choices": [
          "Design Review",
          "Launch Check",
          "Budget Sync"
        ]
      }
    ],
    "interpolation": "dollar_brace"
  },
  "requirements": {
    "black_box_compatible": true,
    "memory_adapter_preferred": false,
    "memory_adapter_required": false,
    "capabilities": [
      "respond"
    ]
  },
  "execution": {
    "repetitions": 1,
    "reset_between_repetitions": true,
    "max_agent_turns": 4,
    "on_agent_error": "fail_probe",
    "on_timeout": "fail_probe"
  },
  "leakage": {
    "probe_sampling": "late",
    "future_probe_visible_during_formation": false,
    "oracle_visible_to_agent": false,
    "ablation_labels_visible_to_agent": false,
    "hidden_world_state_visible_to_agent": false
  },
  "actors": [
    {
      "id": "user",
      "kind": "person",
      "display_name": "Benchmark User"
    },
    {
      "id": "person",
      "kind": "person",
      "display_name": "${person_name}"
    },
    {
      "id": "calendar",
      "kind": "tool",
      "display_name": "Calendar Tool"
    }
  ],
  "world": {
    "clock": {
      "mode": "virtual",
      "start": "2026-01-01T09:00:00Z",
      "timezone": "UTC"
    },
    "state": {},
    "hidden_ground_truth": {
      "authoritative_meeting_time": "${calendar_time}"
    }
  },
  "timeline": [
    {
      "id": "e-policy",
      "stage": "past",
      "type": "observation",
      "at": {
        "sequence": 1
      },
      "visibility": "agent",
      "content": "Workspace scheduling policy: the Calendar Tool record is the authoritative start time for any meeting. A meeting owner's own statement is not binding until the Calendar Tool reflects it.",
      "tags": [
        "relevant",
        "policy"
      ],
      "payload": {
        "kind": "workspace_policy",
        "authority": "calendar_tool_for_scheduling",
        "owner_statements_binding": false
      }
    },
    {
      "id": "e-human",
      "stage": "past",
      "type": "interaction",
      "at": {
        "sequence": 2
      },
      "visibility": "agent",
      "actor": "person",
      "content": "I own the ${meeting_name} and I scheduled it myself, so I can tell you directly: it starts at ${human_time}.",
      "tags": [
        "relevant",
        "human-source"
      ]
    },
    {
      "id": "e-tool",
      "stage": "past",
      "type": "tool_result",
      "at": {
        "sequence": 3
      },
      "visibility": "agent",
      "actor": "calendar",
      "payload": {
        "meeting": "${meeting_name}",
        "start": "${calendar_time}",
        "status": "auto_synced",
        "confirmed_by_owner": false,
        "note": "Imported from the workspace calendar feed."
      },
      "tags": [
        "relevant",
        "tool-source"
      ]
    },
    {
      "id": "d-1",
      "stage": "interference",
      "type": "distractor",
      "at": {
        "sequence": 20
      },
      "visibility": "agent",
      "actor": "user",
      "content": "The meeting room has a new projector.",
      "tags": [
        "irrelevant"
      ]
    },
    {
      "id": "cp",
      "stage": "pre_probe",
      "type": "checkpoint",
      "at": {
        "sequence": 40
      },
      "visibility": "harness"
    }
  ],
  "probes": [
    {
      "id": "p-use",
      "kind": "epistemic",
      "trigger": {
        "after_event": "cp"
      },
      "delivery": "respond",
      "input": {
        "content": "What start time should you use to schedule the ${meeting_name}? Answer with the time only."
      },
      "oracle": {
        "accepted": [
          "${calendar_time}"
        ],
        "forbidden": [
          "${human_time}"
        ],
        "expected_status": "known"
      },
      "evaluators": [
        "eval-time"
      ],
      "dimensions": [
        "epistemic_memory"
      ],
      "weight": 1.0
    },
    {
      "id": "p-human",
      "kind": "epistemic",
      "trigger": {
        "after_event": "cp"
      },
      "delivery": "respond",
      "input": {
        "content": "What time did ${person_name} personally claim for the ${meeting_name}? Answer with the time only."
      },
      "oracle": {
        "accepted": [
          "${human_time}"
        ]
      },
      "evaluators": [
        "eval-time"
      ],
      "dimensions": [
        "epistemic_memory"
      ],
      "weight": 1.0
    }
  ],
  "ablations": [
    {
      "id": "a-tool",
      "kind": "relevant_memory",
      "probes": [
        "p-use"
      ],
      "method": "replay_excluding_events",
      "expected_effect": "degrade",
      "targets": {
        "event_ids": [
          "e-tool"
        ]
      }
    },
    {
      "id": "a-policy",
      "kind": "relevant_memory",
      "probes": [
        "p-use"
      ],
      "method": "replay_excluding_events",
      "expected_effect": "degrade",
      "targets": {
        "event_ids": [
          "e-policy"
        ]
      },
      "oracle_value_survives_by_design": true,
      "description": "The Calendar Tool time necessarily remains visible in e-tool; the Ablation removes the remembered policy that makes that record authoritative. Without it the owner's first-hand claim is the plausible answer, so a competent Agent stops producing the tool time."
    },
    {
      "id": "a-human",
      "kind": "relevant_memory",
      "probes": [
        "p-human"
      ],
      "method": "replay_excluding_events",
      "expected_effect": "degrade",
      "targets": {
        "event_ids": [
          "e-human"
        ]
      }
    },
    {
      "id": "a-irrelevant",
      "kind": "irrelevant_memory",
      "probes": [
        "p-use",
        "p-human"
      ],
      "method": "replay_excluding_events",
      "expected_effect": "neutral",
      "targets": {
        "event_ids": [
          "d-1"
        ]
      },
      "tolerance": 0.05
    }
  ],
  "evaluators": [
    {
      "id": "eval-time",
      "type": "set_match",
      "config": {
        "normalization": "casefold_trim"
      }
    }
  ],
  "scoring": {
    "probe_aggregation": "weighted_mean",
    "score_range": {
      "min": 0,
      "max": 100
    },
    "dimension_weights": {
      "epistemic_memory": 0.8,
      "causal_memory_impact": 0.2
    },
    "causal_metrics": [
      "causal_memory_impact",
      "irrelevant_memory_stability"
    ]
  },
  "metadata": {
    "visibility": "public_dev",
    "profile": "MIB-Core-0.1-Dev-M3",
    "test_plan": "MIB-v0.1-Test-Plan.md",
    "canonical_dev_slice": 1
  }
}
