{
  "mib": "0.1",
  "kind": "MemoryEpisodeProgram",
  "id": "MIB-X-002",
  "version": "0.1.0",
  "status": "candidate",
  "title": "Source Conflict + Time + Action",
  "description": "Combines source authority, temporal update, historical attribution, and future scheduling choice.",
  "suite": "cross",
  "dimensions": [
    "retention_retrieval",
    "temporal_memory",
    "epistemic_memory",
    "causal_memory_impact"
  ],
  "tags": [
    "cross-dimension",
    "public-dev"
  ],
  "difficulty": {
    "level": "medium",
    "meaningful_events": 6,
    "distractor_events": 1,
    "entity_count": 2,
    "memory_hops": 1,
    "probe_indirectness": 0.5
  },
  "template": {
    "is_template": true,
    "parameters": [
      {
        "name": "user_name",
        "type": "string",
        "source": "choice",
        "visibility": "public",
        "choices": [
          "Nia",
          "Oren",
          "Pia",
          "Ravi"
        ]
      },
      {
        "name": "human_name",
        "type": "string",
        "source": "choice",
        "visibility": "public",
        "choices": [
          "Alice",
          "Bob",
          "Mina",
          "Theo"
        ]
      },
      {
        "name": "old_time",
        "type": "string",
        "source": "choice",
        "visibility": "public",
        "choices": [
          "14:00",
          "15:30",
          "10:15"
        ]
      },
      {
        "name": "new_time",
        "type": "string",
        "source": "choice",
        "visibility": "public",
        "choices": [
          "16:00",
          "17:30",
          "12:15"
        ]
      }
    ],
    "interpolation": "dollar_brace"
  },
  "requirements": {
    "black_box_compatible": true,
    "memory_adapter_preferred": false,
    "memory_adapter_required": false,
    "capabilities": [
      "respond",
      "virtual_time"
    ]
  },
  "execution": {
    "repetitions": 1,
    "reset_between_repetitions": true,
    "max_agent_turns": 20,
    "max_tool_calls": 20,
    "on_agent_error": "fail_probe",
    "on_timeout": "fail_probe"
  },
  "leakage": {
    "probe_sampling": "late",
    "future_probe_visible_during_formation": false,
    "oracle_visible_to_agent": false,
    "ablation_labels_visible_to_agent": false,
    "hidden_world_state_visible_to_agent": false
  },
  "actors": [
    {
      "id": "user",
      "kind": "person",
      "display_name": "${user_name}"
    }
  ],
  "world": {
    "clock": {
      "mode": "virtual",
      "start": "2026-01-01T09:00:00Z",
      "timezone": "UTC"
    },
    "state": {}
  },
  "timeline": [
    {
      "id": "e-policy",
      "stage": "past",
      "type": "observation",
      "at": {
        "sequence": 1
      },
      "visibility": "agent",
      "content": "For scheduling decisions in this workspace, confirmed Calendar Tool results are authoritative.",
      "tags": [
        "relevant",
        "policy"
      ]
    },
    {
      "id": "e-human-old",
      "stage": "past",
      "type": "interaction",
      "at": {
        "sequence": 2
      },
      "visibility": "agent",
      "actor": "user",
      "content": "${human_name} told me the review starts at ${old_time}.",
      "tags": [
        "relevant",
        "human-source"
      ]
    },
    {
      "id": "e-tool-old",
      "stage": "past",
      "type": "tool_result",
      "at": {
        "sequence": 3
      },
      "visibility": "agent",
      "payload": {
        "meeting": "Review",
        "start": "${old_time}",
        "status": "confirmed"
      },
      "tags": [
        "relevant",
        "tool-source",
        "historical"
      ]
    },
    {
      "id": "e-human-new",
      "stage": "past",
      "type": "interaction",
      "at": {
        "sequence": 20
      },
      "visibility": "agent",
      "actor": "user",
      "content": "${human_name} says the review may have moved to ${new_time}.",
      "tags": [
        "relevant",
        "human-source",
        "tentative"
      ]
    },
    {
      "id": "e-tool-new",
      "stage": "past",
      "type": "tool_result",
      "at": {
        "sequence": 21
      },
      "visibility": "agent",
      "payload": {
        "meeting": "Review",
        "start": "${new_time}",
        "status": "confirmed"
      },
      "tags": [
        "relevant",
        "tool-source",
        "current"
      ]
    },
    {
      "id": "d1",
      "stage": "interference",
      "type": "distractor",
      "at": {
        "sequence": 40
      },
      "visibility": "agent",
      "actor": "user",
      "content": "The review room has a new whiteboard.",
      "tags": [
        "irrelevant"
      ]
    },
    {
      "id": "cp",
      "stage": "pre_probe",
      "type": "checkpoint",
      "at": {
        "sequence": 60
      },
      "visibility": "harness"
    }
  ],
  "probes": [
    {
      "id": "p-current",
      "kind": "epistemic",
      "trigger": {
        "after_event": "cp"
      },
      "delivery": "respond",
      "input": {
        "content": "What start time should you use to schedule the Review now? Answer with the time only."
      },
      "oracle": {
        "accepted": [
          "${new_time}"
        ],
        "forbidden": [
          "${old_time}"
        ]
      },
      "evaluators": [
        "eval-time"
      ],
      "dimensions": [
        "temporal_memory",
        "epistemic_memory"
      ],
      "weight": 1.0
    },
    {
      "id": "p-history",
      "kind": "historical",
      "trigger": {
        "after_event": "cp"
      },
      "delivery": "respond",
      "input": {
        "content": "What time did the Calendar Tool originally confirm for the Review before it changed? Answer with the time only."
      },
      "oracle": {
        "accepted": [
          "${old_time}"
        ]
      },
      "evaluators": [
        "eval-time"
      ],
      "dimensions": [
        "retention_retrieval",
        "temporal_memory",
        "epistemic_memory"
      ],
      "weight": 1.0
    }
  ],
  "ablations": [
    {
      "id": "a-current",
      "kind": "relevant_memory",
      "probes": [
        "p-current"
      ],
      "method": "replay_excluding_events",
      "targets": {
        "event_ids": [
          "e-tool-new"
        ]
      },
      "expected_effect": "degrade"
    },
    {
      "id": "a-history",
      "kind": "relevant_memory",
      "probes": [
        "p-history"
      ],
      "method": "replay_excluding_events",
      "targets": {
        "event_ids": [
          "e-tool-old"
        ]
      },
      "expected_effect": "degrade"
    },
    {
      "id": "a-irrelevant",
      "kind": "irrelevant_memory",
      "probes": [
        "p-current",
        "p-history"
      ],
      "method": "replay_excluding_events",
      "targets": {
        "event_ids": [
          "d1"
        ]
      },
      "expected_effect": "neutral"
    }
  ],
  "evaluators": [
    {
      "id": "eval-time",
      "type": "set_match",
      "config": {
        "normalization": "casefold_trim"
      }
    }
  ],
  "scoring": {
    "probe_aggregation": "weighted_mean",
    "score_range": {
      "min": 0,
      "max": 100
    },
    "dimension_weights": {
      "retention_retrieval": 0.1,
      "temporal_memory": 0.3,
      "epistemic_memory": 0.35,
      "causal_memory_impact": 0.25
    },
    "causal_metrics": [
      "causal_memory_impact",
      "memory_benefit",
      "irrelevant_memory_stability",
      "negative_transfer",
      "error_recurrence"
    ]
  },
  "metadata": {
    "visibility": "public_dev",
    "profile": "MIB-Core-0.1",
    "test_plan": "MIB-v0.1-Test-Plan.md",
    "canonical_dev_slice": 3
  }
}
