{
  "mib": "0.1",
  "kind": "MemoryEpisodeProgram",
  "id": "MIB-TIME-001",
  "version": "0.1.0",
  "status": "candidate",
  "title": "Current Value After Update",
  "description": "Tests adoption of a new current value while world truth remains updated even if the visible update memory is ablated.",
  "suite": "time",
  "dimensions": [
    "temporal_memory",
    "causal_memory_impact"
  ],
  "tags": [
    "current-state",
    "update",
    "stale-suppression"
  ],
  "difficulty": {
    "level": "easy",
    "meaningful_events": 2,
    "distractor_events": 1,
    "entity_count": 1,
    "memory_hops": 0,
    "probe_indirectness": 0.2
  },
  "template": {
    "is_template": true,
    "parameters": [
      {
        "name": "user_name",
        "type": "string",
        "source": "choice",
        "visibility": "public",
        "choices": [
          "Mina",
          "Oren",
          "Pia",
          "Darin"
        ]
      },
      {
        "name": "old_zone",
        "type": "string",
        "source": "choice",
        "visibility": "public",
        "choices": [
          "UTC+2",
          "UTC+3",
          "UTC-4"
        ]
      },
      {
        "name": "new_zone",
        "type": "string",
        "source": "choice",
        "visibility": "public",
        "choices": [
          "UTC+7",
          "UTC+8",
          "UTC-1"
        ]
      }
    ],
    "interpolation": "dollar_brace"
  },
  "requirements": {
    "black_box_compatible": true,
    "memory_adapter_preferred": false,
    "memory_adapter_required": false,
    "capabilities": [
      "respond",
      "virtual_time"
    ]
  },
  "execution": {
    "repetitions": 1,
    "reset_between_repetitions": true,
    "max_agent_turns": 4,
    "on_agent_error": "fail_probe",
    "on_timeout": "fail_probe"
  },
  "leakage": {
    "probe_sampling": "late",
    "future_probe_visible_during_formation": false,
    "oracle_visible_to_agent": false,
    "ablation_labels_visible_to_agent": false,
    "hidden_world_state_visible_to_agent": false
  },
  "actors": [
    {
      "id": "user",
      "kind": "person",
      "display_name": "${user_name}"
    }
  ],
  "world": {
    "clock": {
      "mode": "virtual",
      "start": "2026-01-01T09:00:00Z",
      "timezone": "UTC"
    },
    "state": {
      "current_timezone": "${old_zone}"
    },
    "hidden_ground_truth": {
      "current_timezone": "${new_zone}"
    }
  },
  "timeline": [
    {
      "id": "e-old",
      "stage": "past",
      "type": "interaction",
      "at": {
        "sequence": 1,
        "time": "2026-01-01T09:00:00Z"
      },
      "visibility": "agent",
      "actor": "user",
      "content": "My current timezone is ${old_zone}.",
      "tags": [
        "relevant",
        "historical"
      ]
    },
    {
      "id": "w-update",
      "stage": "past",
      "type": "world_update",
      "at": {
        "sequence": 30,
        "time": "2026-01-08T12:00:00Z"
      },
      "visibility": "harness",
      "world_updates": [
        {
          "op": "set",
          "path": "/current_timezone",
          "value": "${new_zone}"
        }
      ],
      "tags": [
        "world-truth"
      ]
    },
    {
      "id": "e-update",
      "stage": "past",
      "type": "interaction",
      "at": {
        "sequence": 31,
        "time": "2026-01-08T12:05:00Z"
      },
      "visibility": "agent",
      "actor": "user",
      "content": "I have moved. My current timezone is now ${new_zone}.",
      "tags": [
        "relevant",
        "current"
      ]
    },
    {
      "id": "d-1",
      "stage": "interference",
      "type": "distractor",
      "at": {
        "sequence": 45,
        "time": "2026-01-08T15:30:00Z"
      },
      "visibility": "agent",
      "actor": "user",
      "content": "I bought a new notebook today.",
      "tags": [
        "irrelevant"
      ]
    },
    {
      "id": "cp",
      "stage": "pre_probe",
      "type": "checkpoint",
      "at": {
        "sequence": 60,
        "time": "2026-01-09T09:00:00Z"
      },
      "visibility": "harness"
    }
  ],
  "probes": [
    {
      "id": "p-current",
      "kind": "temporal",
      "trigger": {
        "after_event": "cp"
      },
      "delivery": "respond",
      "input": {
        "content": "What is my current timezone? Answer with the UTC offset only."
      },
      "oracle": {
        "accepted": [
          "${new_zone}"
        ],
        "forbidden": [
          "${old_zone}"
        ],
        "expected_status": "known"
      },
      "evaluators": [
        "eval-zone"
      ],
      "dimensions": [
        "temporal_memory"
      ],
      "weight": 1.0
    }
  ],
  "ablations": [
    {
      "id": "a-relevant",
      "kind": "relevant_memory",
      "probes": [
        "p-current"
      ],
      "method": "replay_excluding_events",
      "expected_effect": "degrade",
      "targets": {
        "event_ids": [
          "e-update"
        ]
      }
    },
    {
      "id": "a-irrelevant",
      "kind": "irrelevant_memory",
      "probes": [
        "p-current"
      ],
      "method": "replay_excluding_events",
      "expected_effect": "neutral",
      "targets": {
        "event_ids": [
          "d-1"
        ]
      },
      "tolerance": 0.05
    }
  ],
  "evaluators": [
    {
      "id": "eval-zone",
      "type": "set_match",
      "config": {
        "normalization": "casefold_trim"
      }
    }
  ],
  "scoring": {
    "probe_aggregation": "weighted_mean",
    "score_range": {
      "min": 0,
      "max": 100
    },
    "dimension_weights": {
      "temporal_memory": 0.8,
      "causal_memory_impact": 0.2
    },
    "causal_metrics": [
      "causal_memory_impact",
      "irrelevant_memory_stability"
    ]
  },
  "metadata": {
    "visibility": "public_dev",
    "profile": "MIB-Core-0.1-Dev-M3",
    "test_plan": "MIB-v0.1-Test-Plan.md",
    "canonical_dev_slice": 1
  }
}
