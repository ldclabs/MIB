{
  "mib": "0.1",
  "kind": "MemoryEpisodeProgram",
  "id": "MIB-EXP-003",
  "version": "0.1.0",
  "status": "candidate",
  "title": "Hidden Preconditions From Prediction Error",
  "description": "Tests whether prediction error is retained as a reusable hidden precondition for future action.",
  "suite": "experience",
  "dimensions": [
    "experience_memory",
    "causal_memory_impact"
  ],
  "tags": [
    "prediction-error",
    "hidden-precondition",
    "failure-avoidance"
  ],
  "difficulty": {
    "level": "medium",
    "meaningful_events": 4,
    "distractor_events": 1,
    "entity_count": 2,
    "memory_hops": 1,
    "experience_steps": 4,
    "probe_indirectness": 0.6
  },
  "template": {
    "is_template": true,
    "parameters": [],
    "interpolation": "dollar_brace"
  },
  "requirements": {
    "black_box_compatible": true,
    "memory_adapter_preferred": false,
    "memory_adapter_required": false,
    "capabilities": [
      "observe",
      "act",
      "tools"
    ]
  },
  "execution": {
    "repetitions": 1,
    "reset_between_repetitions": true,
    "max_agent_turns": 12,
    "max_tool_calls": 10,
    "on_agent_error": "fail_probe",
    "on_timeout": "fail_probe"
  },
  "leakage": {
    "probe_sampling": "late",
    "future_probe_visible_during_formation": false,
    "oracle_visible_to_agent": false,
    "ablation_labels_visible_to_agent": false,
    "hidden_world_state_visible_to_agent": false
  },
  "world": {
    "clock": {
      "mode": "virtual",
      "start": "2026-01-01T09:00:00Z",
      "timezone": "UTC"
    },
    "state": {
      "workspace": {
        "workspace_required": true,
        "selected_workspace": null,
        "edited": false,
        "saved": false,
        "last_error": null
      }
    },
    "tools": [
      {
        "id": "workspace",
        "version": "0.1.0",
        "simulator_binding": "mib.workspace.v1",
        "operations": [
          {
            "name": "select_workspace",
            "description": "Select the workspace in which the record will be saved.",
            "input_schema": {
              "type": "object",
              "properties": {
                "workspace": {
                  "type": "string"
                }
              },
              "required": [
                "workspace"
              ]
            }
          },
          {
            "name": "edit_record",
            "description": "Edit the current record.",
            "input_schema": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                }
              }
            }
          },
          {
            "name": "save",
            "description": "Save the edited record.",
            "input_schema": {
              "type": "object",
              "properties": {}
            }
          },
          {
            "name": "inspect_status",
            "description": "Inspect current workspace save state.",
            "input_schema": {
              "type": "object",
              "properties": {}
            }
          }
        ]
      }
    ],
    "hidden_ground_truth": {}
  },
  "timeline": [
    {
      "id": "e-expect",
      "stage": "past",
      "type": "feedback",
      "at": {
        "sequence": 1
      },
      "visibility": "agent",
      "content": "In the previous task, we expected Save to work immediately after editing.",
      "tags": [
        "relevant"
      ]
    },
    {
      "id": "e-error",
      "stage": "past",
      "type": "tool_result",
      "at": {
        "sequence": 2
      },
      "visibility": "agent",
      "payload": {
        "operation": "save",
        "success": false,
        "error": "workspace_required"
      },
      "tags": [
        "relevant"
      ]
    },
    {
      "id": "e-lesson",
      "stage": "past",
      "type": "feedback",
      "at": {
        "sequence": 3
      },
      "visibility": "agent",
      "content": "The unexpected failure revealed a hidden precondition: select the workspace before saving.",
      "tags": [
        "relevant"
      ]
    },
    {
      "id": "e-success",
      "stage": "past",
      "type": "feedback",
      "at": {
        "sequence": 4
      },
      "visibility": "agent",
      "content": "After selecting the workspace, editing, and saving, the record was stored successfully.",
      "tags": [
        "relevant"
      ]
    },
    {
      "id": "d1",
      "stage": "past",
      "type": "distractor",
      "at": {
        "sequence": 35
      },
      "visibility": "agent",
      "content": "Unrelated note: the record title font changed.",
      "tags": [
        "irrelevant"
      ]
    },
    {
      "id": "cp",
      "stage": "pre_probe",
      "type": "checkpoint",
      "at": {
        "sequence": 100
      },
      "visibility": "harness"
    }
  ],
  "probes": [
    {
      "id": "p-action",
      "kind": "action",
      "trigger": {
        "after_event": "cp"
      },
      "delivery": "act",
      "input": {
        "goal": "Update the record and save it successfully.",
        "available_tools": [
          "workspace.select_workspace",
          "workspace.edit_record",
          "workspace.save"
        ]
      },
      "oracle": {
        "world_assertions": [
          {
            "path": "/workspace/saved",
            "operator": "eq",
            "value": true
          }
        ],
        "trajectory_requirements": [
          {
            "type": "required_action",
            "action": "workspace.select_workspace"
          },
          {
            "type": "before",
            "first": "workspace.select_workspace",
            "second": "workspace.save"
          },
          {
            "type": "max_occurrences",
            "action": "workspace.save",
            "count": 1
          }
        ]
      },
      "evaluators": [
        "eval-composite"
      ],
      "dimensions": [
        "experience_memory",
        "causal_memory_impact"
      ],
      "weight": 1.0
    }
  ],
  "ablations": [
    {
      "id": "a-relevant",
      "kind": "relevant_memory",
      "probes": [
        "p-action"
      ],
      "method": "replay_excluding_events",
      "targets": {
        "event_ids": [
          "e-error",
          "e-lesson",
          "e-success"
        ]
      },
      "expected_effect": "degrade"
    },
    {
      "id": "a-irrelevant",
      "kind": "irrelevant_memory",
      "probes": [
        "p-action"
      ],
      "method": "replay_excluding_events",
      "targets": {
        "event_ids": [
          "d1"
        ]
      },
      "expected_effect": "neutral"
    }
  ],
  "evaluators": [
    {
      "id": "eval-world",
      "type": "world_state",
      "config": {}
    },
    {
      "id": "eval-trajectory",
      "type": "trajectory",
      "config": {}
    },
    {
      "id": "eval-composite",
      "type": "composite",
      "components": [
        {
          "evaluator": "eval-world",
          "weight": 0.6
        },
        {
          "evaluator": "eval-trajectory",
          "weight": 0.4
        }
      ]
    }
  ],
  "scoring": {
    "probe_aggregation": "weighted_mean",
    "score_range": {
      "min": 0,
      "max": 100
    },
    "dimension_weights": {
      "experience_memory": 0.8,
      "causal_memory_impact": 0.2
    },
    "causal_metrics": [
      "causal_memory_impact",
      "memory_benefit",
      "irrelevant_memory_stability",
      "negative_transfer",
      "error_recurrence"
    ]
  },
  "metadata": {
    "visibility": "public_dev",
