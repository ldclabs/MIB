{
  "mib": "0.1",
  "kind": "MemoryEpisodeProgram",
  "id": "MIB-EXP-002",
  "version": "0.1.0",
  "status": "candidate",
  "title": "Outcome Disambiguation",
  "description": "Tests whether the Agent binds outcome to the correct prior trajectory rather than reusing a similar failed attempt.",
  "suite": "experience",
  "dimensions": [
    "experience_memory",
    "causal_memory_impact"
  ],
  "tags": [
    "outcome",
    "experience-selection",
    "action"
  ],
  "difficulty": {
    "level": "medium",
    "meaningful_events": 3,
    "distractor_events": 1,
    "entity_count": 2,
    "memory_hops": 1,
    "experience_steps": 4,
    "probe_indirectness": 0.6
  },
  "template": {
    "is_template": true,
    "parameters": [
      {
        "name": "actual_target",
        "type": "string",
        "source": "choice",
        "visibility": "public",
        "choices": [
          "db-ivory",
          "db-nova",
          "db-cedar"
        ]
      },
      {
        "name": "wrong_target",
        "type": "string",
        "source": "choice",
        "visibility": "public",
        "choices": [
          "db-legacy",
          "db-stage",
          "db-mirror"
        ]
      }
    ],
    "interpolation": "dollar_brace"
  },
  "requirements": {
    "black_box_compatible": true,
    "memory_adapter_preferred": false,
    "memory_adapter_required": false,
    "capabilities": [
      "observe",
      "act",
      "tools"
    ]
  },
  "execution": {
    "repetitions": 1,
    "reset_between_repetitions": true,
    "max_agent_turns": 12,
    "max_tool_calls": 10,
    "on_agent_error": "fail_probe",
    "on_timeout": "fail_probe"
  },
  "leakage": {
    "probe_sampling": "late",
    "future_probe_visible_during_formation": false,
    "oracle_visible_to_agent": false,
    "ablation_labels_visible_to_agent": false,
    "hidden_world_state_visible_to_agent": false
  },
  "world": {
    "clock": {
      "mode": "virtual",
      "start": "2026-01-01T09:00:00Z",
      "timezone": "UTC"
    },
    "state": {
      "deployment": {
        "actual_target": "${actual_target}",
        "selected_target": "${wrong_target}",
        "migration_applied": false,
        "service_running": false,
        "last_error": null
      }
    },
    "tools": [
      {
        "id": "deployment",
        "version": "0.1.0",
        "simulator_binding": "mib.deployment.v1",
        "operations": [
          {
            "name": "inspect_target",
            "description": "Inspect the actual deployment target and the currently selected target.",
            "input_schema": {
              "type": "object",
              "properties": {}
            }
          },
          {
            "name": "select_target",
            "description": "Select the database target for subsequent migration operations.",
            "input_schema": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "string"
                }
              },
              "required": [
                "target"
              ]
            }
          },
          {
            "name": "run_migration",
            "description": "Apply the pending migration to the currently selected target.",
            "input_schema": {
              "type": "object",
              "properties": {}
            }
          },
          {
            "name": "restart_service",
            "description": "Restart the service and report whether startup succeeds.",
            "input_schema": {
              "type": "object",
              "properties": {}
            }
          },
          {
            "name": "read_error",
            "description": "Read the most recent deployment error.",
            "input_schema": {
              "type": "object",
              "properties": {}
            }
          }
        ]
      }
    ],
    "hidden_ground_truth": {}
  },
  "timeline": [
    {
      "id": "e-a",
      "stage": "past",
      "type": "feedback",
      "at": {
        "sequence": 1
      },
      "visibility": "agent",
      "content": "Attempt Alpha restarted immediately after migration and ended in a startup failure.",
      "tags": [
        "relevant"
      ]
    },
    {
      "id": "e-b1",
      "stage": "past",
      "type": "feedback",
      "at": {
        "sequence": 3
      },
      "visibility": "agent",
      "content": "Attempt Beta first inspected the actual target before applying migration.",
      "tags": [
        "relevant"
      ]
    },
    {
      "id": "e-b2",
      "stage": "past",
      "type": "feedback",
      "at": {
        "sequence": 4
      },
      "visibility": "agent",
      "content": "Attempt Beta selected the actual target, migrated it, restarted, and the outcome was success.",
      "tags": [
        "relevant"
      ]
    },
    {
      "id": "d1",
      "stage": "past",
      "type": "distractor",
      "at": {
        "sequence": 30
      },
      "visibility": "agent",
      "content": "A separate deployment used a different logo and no database changes.",
      "tags": [
        "irrelevant"
      ]
    },
    {
      "id": "cp",
      "stage": "pre_probe",
      "type": "checkpoint",
      "at": {
        "sequence": 100
      },
      "visibility": "harness"
    }
  ],
  "probes": [
    {
      "id": "p-action",
      "kind": "action",
      "trigger": {
        "after_event": "cp"
      },
      "delivery": "act",
      "input": {
        "goal": "Use the previously successful pattern to complete this deployment.",
        "available_tools": [
          "deployment.inspect_target",
          "deployment.select_target",
          "deployment.run_migration",
          "deployment.restart_service"
        ]
      },
      "oracle": {
        "world_assertions": [
          {
            "path": "/deployment/service_running",
            "operator": "eq",
            "value": true
          }
        ],
        "trajectory_requirements": [
          {
            "type": "required_action",
            "action": "deployment.inspect_target"
          },
          {
            "type": "before",
            "first": "deployment.inspect_target",
            "second": "deployment.run_migration"
          }
        ]
      },
      "evaluators": [
        "eval-composite"
      ],
      "dimensions": [
        "experience_memory",
        "causal_memory_impact"
      ],
      "weight": 1.0
    }
  ],
  "ablations": [
    {
      "id": "a-success-experience",
      "kind": "relevant_memory",
      "probes": [
        "p-action"
      ],
      "method": "replay_excluding_events",
      "targets": {
        "event_ids": [
          "e-b1",
          "e-b2"
        ]
      },
      "expected_effect": "degrade"
    },
    {
      "id": "a-irrelevant",
      "kind": "irrelevant_memory",
      "probes": [
        "p-action"
      ],
      "method": "replay_excluding_events",
      "targets": {
        "event_ids": [
          "d1"
        ]
      },
      "expected_effect": "neutral"
    }
  ],
  "evaluators": [
    {
      "id": "eval-world",
      "type": "world_state",
      "config": {}
    },
    {
      "id": "eval-trajectory",
      "type": "trajectory",
      "config": {}
    },
    {
      "id": "eval-composite",
      "type": "composite",
      "components": [
        {
          "evaluator": "eval-world",
          "weight": 0.6
        },
        {
          "evaluator": "eval-trajectory",
          "weight": 0.4
        }
      ]
    }
  ],
  "scoring": {
    "probe_aggregation": "weighted_mean",
    "score_range": {
      "min": 0,
      "max": 100
    },
    "dimension_weights": {
      "experience_memory": 0.8,
      "causal_memory_impact": 0.2
    },
    "causal_metrics": [
      "causal_memory_impact",
      "memory_benefit",
      "irrelevant_memory_stability",
      "negative_transfer",
      "error_recurrence"
    ]
  },
  "metadata": {
    "visibility": "public_dev",
    "profile": "MIB-Core-0.1",
    "milestone": "Reference Runner M2"
  }
}
